{
  "name": "willy-seo",
  "version": "1.0.0",
  "description": "Willy SEO — Complemento y Asesor SEO Inteligente para ChatGPT (Apps SDK + MCP)",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --test dist/tests/auditor.test.js",
    "pack:zip": "npm run build && zip -r willy-seo.zip . -x 'node_modules/*' '.git/*' '*.DS_Store' '*.zip'"
