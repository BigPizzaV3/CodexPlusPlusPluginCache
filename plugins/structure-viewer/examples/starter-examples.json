        },
        {
          "order": 3,
          "tool": "structure.analyze",
          "purpose": "Run contacts between object-scoped chains A and B with contactDistanceAngstrom 4.",
          "request": {
            "sessionId": "$VIEWER_SESSION_ID",
            "expectedRevision": "$INITIAL_SCENE_REVISION",
            "kind": "contacts",
            "limit": 500,
            "options": {
              "contactDistanceAngstrom": 4
            },
            "selections": [
              {
                "kind": "chain",
