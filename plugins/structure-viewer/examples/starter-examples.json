                "objectId": "primary"
              },
              {
                "kind": "chain",
                "chain": "B",
                "objectId": "primary"
              }
            ]
          },
          "resultBindings": {
            "structuredContent.state.appliedRevision": "$CONTACTS_APPLIED_REVISION",
            "structuredContent.state.analysis.provenance": "$CONTACTS_METHOD_PROVENANCE"
          }
        },
        {
          "order": 4,
          "tool": "structure.analyze",
          "purpose": "Run buried_area on the same atom-disjoint chains with probeRadiusAngstrom 1.4 and sasaSamples 240.",
          "request": {
            "sessionId": "$VIEWER_SESSION_ID",
            "expectedRevision": "$CONTACTS_APPLIED_REVISION",
            "kind": "buried_area",
            "limit": 10,
            "options": {
              "probeRadiusAngstrom": 1.4,
              "sasaSamples": 240
            },
            "selections": [
              {
                "kind": "chain",
                "chain": "A",
                "objectId": "primary"
              },
              {
                "kind": "chain",
                "chain": "B",
                "objectId": "primary"
              }
