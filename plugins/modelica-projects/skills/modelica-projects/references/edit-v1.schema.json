{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theisegoria/chatgpt-skill-plugins/schemas/modelica-projects/edit-v1.schema.json",
  "title": "Modelica Projects source-preserving edit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operations"],
  "properties": {
    "version": {"const": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["action", "path", "visual"],
            "properties": {"action": {"const": "set-visual"}, "path": {"$ref": "canonical-v2.schema.json#/$defs/path"}, "visual": {"$ref": "canonical-v2.schema.json#/$defs/visual"}, "replaceGraphics": {"type": "boolean"}, "relayout": {"type": "boolean"}}
          },
          {
            "type": "object", "additionalProperties": false, "required": ["action", "path", "source"],
            "properties": {"action": {"const": "add-file"}, "path": {"$ref": "canonical-v2.schema.json#/$defs/path"}, "source": {"$ref": "canonical-v2.schema.json#/$defs/text"}, "kind": {"$ref": "canonical-v2.schema.json#/$defs/kind"}, "documentation": {"$ref": "canonical-v2.schema.json#/$defs/optionalText"}, "example": {"type": "boolean"}, "test": {"type": "boolean"}}
          },
          {
            "type": "object", "additionalProperties": false, "required": ["action", "path"],
            "properties": {"action": {"const": "repair"}, "path": {"$ref": "canonical-v2.schema.json#/$defs/path"}, "within": {"type": "boolean"}, "lineEndings": {"type": "boolean"}},
            "anyOf": [
              {"required": ["within"], "properties": {"within": {"const": true}}},
              {"required": ["lineEndings"], "properties": {"lineEndings": {"const": true}}}
            ]
          }
        ]
      }
    }
  }
}
