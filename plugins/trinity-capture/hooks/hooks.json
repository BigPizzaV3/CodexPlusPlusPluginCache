{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" SessionStart", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" UserPromptSubmit", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" PreToolUse", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" PostToolUse", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" Stop", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\" SessionEnd", "timeout": 5 }
        ]
      }
    ]
  }
}
