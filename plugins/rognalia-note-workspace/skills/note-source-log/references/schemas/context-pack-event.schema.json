{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:context-pack-event:1",
  "title": "note Workspace context pack registry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "request_id",
    "article_id",
    "path",
    "created_at",
    "source_cards",
    "approved_for_article",
    "payload_sha256",
    "body_sha256",
    "pack_sha256",
    "event_sha256",
    "external_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_type": {"const": "context_pack_created"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
    "article_id": {"type": "string", "pattern": "^article-[a-z0-9][a-z0-9-]{2,63}$"},
    "path": {"type": "string", "pattern": "^context-packs/article-[a-z0-9][a-z0-9-]{2,63}\\.md$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_card_id", "revision", "event_sha256"],
        "properties": {
          "source_card_id": {"type": "string", "pattern": "^src-[a-z0-9]{8,32}$"},
          "revision": {"type": "integer", "minimum": 1},
          "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "approved_for_article": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src-[a-z0-9]{8,32}$"}
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_actions": {"type": "array", "maxItems": 0}
  }
}
