{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:context-pack-input:1",
  "title": "note Workspace context pack input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "article_id",
    "topic",
    "purpose",
    "source_card_ids",
    "approved_for_article",
    "missing_information"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
    "article_id": {"type": "string", "pattern": "^article-[a-z0-9][a-z0-9-]{2,63}$"},
    "topic": {"type": "string", "minLength": 1, "maxLength": 300},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "source_card_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src-[a-z0-9]{8,32}$"}
    },
    "approved_for_article": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src-[a-z0-9]{8,32}$"}
    },
    "missing_information": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    }
  }
}
