{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:standing-instructions-state:1",
  "title": "note Workspace standing instructions state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "revision",
    "updated_at",
    "latest_event_id",
    "instructions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "latest_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^standing-[0-9]{8}-[0-9a-f]{12}$"
        },
        {"type": "null"}
      ]
    },
    "instructions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instruction_id", "category", "text"],
        "properties": {
          "instruction_id": {
            "type": "string",
            "pattern": "^rule-[a-z0-9][a-z0-9-]{2,63}$"
          },
          "category": {
            "enum": ["workflow", "editorial", "image", "safety", "other"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
