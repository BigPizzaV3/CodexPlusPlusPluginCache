{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:standing-instructions-input:1",
  "title": "note Workspace standing instructions input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "reason",
    "approved_by_user",
    "instructions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"
    },
    "reason": {"$ref": "#/$defs/oneLineText"},
    "approved_by_user": {"const": true},
    "instructions": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/instruction"}
    }
  },
  "$defs": {
    "oneLineText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\r\\n]+$"
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_id", "category", "text"],
      "properties": {
        "instruction_id": {
          "type": "string",
          "pattern": "^rule-[a-z0-9][a-z0-9-]{2,63}$"
        },
        "category": {
          "enum": ["workflow", "editorial", "image", "safety", "other"]
        },
        "text": {"$ref": "#/$defs/oneLineText"}
      }
    }
  }
}
