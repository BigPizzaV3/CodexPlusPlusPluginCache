{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:strategy-change-event:1",
  "title": "note Workspace strategy change event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "request_id",
    "revision",
    "changed_at",
    "input",
    "before",
    "after",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^strategy-[0-9]{4}-[0-9a-f]{12}$"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "changed_at": {"type": "string", "format": "date-time"},
    "input": {"type": "object"},
    "before": {"$ref": "#/$defs/state"},
    "after": {"$ref": "#/$defs/state"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "desired_frequency", "minimum_frequency", "cadence_status"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "desired_frequency": {"type": "string", "minLength": 1},
        "minimum_frequency": {"type": "string", "minLength": 1},
        "cadence_status": {"enum": ["active", "paused"]}
      }
    }
  }
}
