{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:article-registry-event:1",
  "title": "note Workspace article registry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_type", "request_id", "payload_sha256", "article_id",
    "revision", "created_at", "status", "selected_title", "context_pack_path",
    "context_pack_sha256", "draft_path", "metadata_path", "draft_sha256",
    "metadata_sha256", "external_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_type": {"const": "draft_saved"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "article_id": {"type": "string", "pattern": "^article-[a-z0-9][a-z0-9-]{2,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "ready_for_image"},
    "selected_title": {"type": "string", "minLength": 1, "maxLength": 200},
    "context_pack_path": {"type": "string", "pattern": "^context-packs/article-[a-z0-9][a-z0-9-]{2,63}\\.md$"},
    "context_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "draft_path": {"type": "string", "pattern": "^articles/drafts/article-[a-z0-9][a-z0-9-]{2,63}-r[0-9]{3}\\.md$"},
    "metadata_path": {"type": "string", "pattern": "^articles/drafts/article-[a-z0-9][a-z0-9-]{2,63}-r[0-9]{3}\\.json$"},
    "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_actions": {"const": []}
  }
}
