{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:image-asset-metadata:1",
  "title": "note Workspace image asset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "payload_sha256", "article_id",
    "article_revision", "kind", "asset_revision", "generated_at", "reviewed_at", "saved_at", "status",
    "selected_title", "brief_path", "brief_sha256", "image_path",
    "image_sha256", "image_format", "width", "height",
    "preview_path", "preview_sha256", "preview_source_sha256",
    "preview_width", "preview_height",
    "generation_attempts", "generator_label",
    "visual_review_completed", "article_match", "anatomy_integrity",
    "crop_safety", "text_accuracy", "extra_text_absent",
    "small_preview_readability", "visual_copy_integration",
    "unresolved_issues", "insertion_heading", "insertion_after",
    "caption", "alt", "metadata_path", "external_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "article_id": {"type": "string"},
    "article_revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["thumbnail", "inline"]},
    "asset_revision": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "saved_at": {"type": "string", "format": "date-time"},
    "status": {"const": "ready_for_draft"},
    "selected_title": {"type": "string"},
    "brief_path": {"type": "string"},
    "brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_path": {"type": "string"},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_format": {"enum": ["png", "jpeg"]},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "preview_path": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "preview_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "preview_source_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "preview_width": {
      "oneOf": [{"type": "null"}, {"type": "integer", "const": 320}]
    },
    "preview_height": {
      "oneOf": [{"type": "null"}, {"type": "integer", "const": 168}]
    },
    "generation_attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "generator_label": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 200}
      ]
    },
    "visual_review_completed": {"const": true},
    "article_match": {"const": "pass"},
    "anatomy_integrity": {"const": "pass"},
    "crop_safety": {"const": "pass"},
    "text_accuracy": {"enum": ["pass", "not_applicable"]},
    "extra_text_absent": {"const": true},
    "small_preview_readability": {"enum": ["pass", "not_applicable"]},
    "visual_copy_integration": {"enum": ["pass", "not_applicable"]},
    "unresolved_issues": {"type": "array", "maxItems": 0},
    "insertion_heading": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 300}
      ]
    },
    "insertion_after": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 500}
      ]
    },
    "caption": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 300}
      ]
    },
    "alt": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 80}
      ]
    },
    "metadata_path": {"type": "string"},
    "external_actions": {"const": []}
  }
}
