{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rognalia:note-workspace:schema:image-brief-metadata:1",
  "title": "note Workspace image brief metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "article_id", "article_revision",
    "article_metadata_path", "article_metadata_sha256", "kind",
    "brief_revision", "created_at", "status", "selected_title",
    "reader_reason", "article_hook", "subject_scene", "design_structure",
    "visual_style", "exact_copy", "copy_rendering", "forbidden_elements",
    "reference_image_count", "reference_guidance", "inline_approved",
    "insertion_heading", "insertion_after", "generation_capability",
    "target_width", "target_height", "brief_path", "payload_sha256",
    "external_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
    "article_id": {"type": "string", "pattern": "^article-[a-z0-9][a-z0-9-]{2,63}$"},
    "article_revision": {"type": "integer", "minimum": 1},
    "article_metadata_path": {"type": "string", "pattern": "^articles/drafts/article-[a-z0-9][a-z0-9-]{2,63}-r[0-9]{3}\\.json$"},
    "article_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["thumbnail", "inline"]},
    "brief_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready_to_generate", "generation_unavailable"]},
    "selected_title": {"type": "string", "minLength": 1, "maxLength": 200},
    "reader_reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "article_hook": {"type": "string", "minLength": 1, "maxLength": 1000},
    "subject_scene": {"type": "string", "minLength": 1, "maxLength": 1000},
    "design_structure": {"type": "string", "minLength": 1, "maxLength": 1000},
    "visual_style": {"type": "string", "minLength": 1, "maxLength": 500},
    "exact_copy": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 32}
      ]
    },
    "copy_rendering": {"enum": ["same_generation", "none"]},
    "forbidden_elements": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "reference_image_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "reference_guidance": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 1000}
      ]
    },
    "inline_approved": {"type": "boolean"},
    "insertion_heading": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 300}
      ]
    },
    "insertion_after": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 500}
      ]
    },
    "generation_capability": {"enum": ["available", "unavailable"]},
    "target_width": {"type": "integer", "minimum": 1},
    "target_height": {"type": "integer", "minimum": 1},
    "brief_path": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_actions": {"const": []}
  }
}
