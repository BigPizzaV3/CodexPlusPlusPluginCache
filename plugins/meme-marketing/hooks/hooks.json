{
  "description": "Meme Marketing guardrails: validate meme batch JSON on write and load the project taste profile at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/validate_meme_batch.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/load_taste_profile.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
