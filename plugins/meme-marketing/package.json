{
  "name": "meme-marketing",
  "version": "3.1.1",
  "description": "Fully Agentic Meme Crafting Engine & CLI - Create relatable, zero-cringe memes with funny doodle line-art, cultural checks, and quality gates",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "meme-craft": "./bin/cli.js",
    "meme-marketing": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/meme-marketing.git"
  },
  "files": [
    "bin",
    "scripts",
    "references",
    "assets",
    "evals",
    "skills",
    "agents",
    "commands",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    "SKILL.md",
    "install.sh"
  ],
  "scripts": {
    "start": "bun bin/cli.js",
    "test": "python3 scripts/test_validate.py && python3 scripts/test_plugin.py",
    "craft": "bun bin/cli.js craft",
    "render": "bun bin/cli.js render",
    "validate": "bun bin/cli.js validate",
    "tune": "bun bin/cli.js tune",
    "lint": "oxlint -c .oxlintrc.json",
    "validate:plugin": "npx -y @anthropic-ai/claude-code plugin validate --strict .claude-plugin/plugin.json && npx -y @anthropic-ai/claude-code plugin validate --strict .claude-plugin/marketplace.json"
  },
  "keywords": [
    "meme",
    "meme-marketing",
    "agent-skill",
    "skills.sh",
    "claude-code",
    "claude-code-plugin",
    "claude-agents",
    "claude-hooks",
    "gemini-cli",
    "antigravity",
    "cursor",
    "codex",
    "bun",
    "typescript",
    "doodle-art"
  ],
  "author": "Mamdouh Aboammar <https://github.com/imMamdouhaboammar>",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.85.0",
    "oxlint": "^1.85.0"
  }
}
