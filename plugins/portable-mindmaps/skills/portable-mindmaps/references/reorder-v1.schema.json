{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theisegoria/chatgpt-skill-plugins/schemas/portable-mindmaps/reorder-v1.schema.json",
  "title": "Portable Mind Maps explicit reorder v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "orders"],
  "properties": {
    "version": {"const": 1},
    "orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent", "children"],
        "properties": {
          "parent": {"$ref": "canonical-v2.schema.json#/$defs/id"},
          "children": {"type": "array", "uniqueItems": true, "maxItems": 4000, "items": {"$ref": "canonical-v2.schema.json#/$defs/id"}}
        }
      }
    }
  }
}
