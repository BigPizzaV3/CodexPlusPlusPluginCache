  "ambiguousOutcomePolicy": {
    "state": "ambiguous_outcome",
    "signals": ["timeout", "connection_loss", "response_lost"],
    "automaticRetry": false,
    "requiredAction": "reconcile",
    "authority": "developer_kit_policy"
  },
  "decisionRules": [
    {
      "signal": "HTTP_400",
      "safeReadDecision": "correct_request",
      "mutationDecision": "correct_request",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_401",
      "safeReadDecision": "reauthenticate",
      "mutationDecision": "reauthenticate_then_reconcile_before_new_attempt",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_403",
      "safeReadDecision": "reauthorize_or_fix_precondition",
      "mutationDecision": "reauthorize_or_fix_precondition",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_404",
      "safeReadDecision": "return_not_found",
      "mutationDecision": "reconcile_if_previous_outcome_was_ambiguous",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_409",
      "safeReadDecision": "reconcile",
      "mutationDecision": "reconcile_without_blind_replay",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_429",
      "safeReadDecision": "honor_retry_after_then_bounded_retry",
      "mutationDecision": "honor_retry_after_for_new_traffic_do_not_replay",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "HTTP_5XX_OR_503",
      "safeReadDecision": "bounded_retry_if_budget_allows",
      "mutationDecision": "reconcile_ambiguous_outcome",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "TIMEOUT_CONNECTION_LOSS_NO_RESPONSE",
      "safeReadDecision": "bounded_retry_if_budget_allows",
      "mutationDecision": "ambiguous_outcome_reconcile_before_new_attempt",
      "authority": "developer_kit_policy"
    },
    {
      "signal": "QUEUED_ACCEPTED",
      "safeReadDecision": "not_applicable",
      "mutationDecision": "await_retrieve_or_verified_message_updated_event",
      "authority": "confirmed_provider_contract"
    },
    {
      "signal": "UNKNOWN_CODE_OR_STATUS",
      "safeReadDecision": "preserve_and_fail_closed",
      "mutationDecision": "preserve_and_fail_closed_no_replay",
      "authority": "developer_kit_policy"
    }
  ],
  "unknownPolicy": {
    "decision": "unknown",
    "automaticRetry": false,
    "preserveOriginalCode": true,
    "preserveUnknownFields": true,
    "messageTextControlsFlow": false,
    "authority": "developer_kit_policy"
  },
