{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragops.dev/schemas/calibration-set-1.0.schema.json",
  "title": "RAGOps evaluator calibration set 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluator", "policy", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluator": {"type": "string", "minLength": 1},
    "policy": {"type": "object"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
