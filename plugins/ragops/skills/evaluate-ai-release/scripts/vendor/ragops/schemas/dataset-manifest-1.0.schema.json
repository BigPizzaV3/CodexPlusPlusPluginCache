{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragops.dev/schemas/dataset-manifest-1.0.schema.json",
  "title": "RAGOps dataset manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "source_classification", "owners", "review_state", "cases", "splits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_classification": {"enum": ["synthetic", "public", "production-derived"]},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_state": {"enum": ["draft", "reviewed", "accepted", "superseded"]},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "splits": {"type": "object", "minProperties": 1}
  }
}
