{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragops.dev/schemas/release-decision-1.0.schema.json",
  "title": "RAGOps release decision 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "decision", "passed", "gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PASS", "WARN", "BLOCK"]},
    "passed": {"type": "boolean"},
    "gates": {"type": "array", "items": {"type": "object"}}
  }
}
