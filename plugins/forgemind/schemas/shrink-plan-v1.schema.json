{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/shrink-plan-v1.schema.json",
  "title": "ForgeMind self-shrinking software plan v1",
  "type": "object",
  "required": ["schemaVersion", "protocol", "id", "sourceMutation", "capabilities", "digest"],
  "properties": { "schemaVersion": { "const": 1 }, "protocol": { "const": "forgemind-self-shrinking-software-v1" }, "id": { "type": "string" }, "sourceMutation": { "const": false }, "capabilities": { "type": "array", "minItems": 1 }, "digest": { "$ref": "#/$defs/digest" } },
  "$defs": { "digest": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
  "additionalProperties": true
}
