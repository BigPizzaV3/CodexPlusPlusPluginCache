{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/engineering-genome-v1.schema.json",
  "title": "ForgeMind engineering genome v1",
  "type": "object",
  "required": ["schemaVersion", "protocol", "id", "minCohort", "outcomeCount", "cohorts", "digest"],
  "properties": { "schemaVersion": { "const": 1 }, "protocol": { "const": "forgemind-engineering-genome-v1" }, "id": { "type": "string" }, "minCohort": { "type": "integer", "minimum": 1 }, "outcomeCount": { "type": "integer", "minimum": 0 }, "cohorts": { "type": "array" }, "digest": { "$ref": "#/$defs/digest" } },
  "$defs": { "digest": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
  "additionalProperties": true
}
