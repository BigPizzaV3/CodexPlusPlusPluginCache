{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/product-loop-v1.schema.json",
  "title": "ForgeMind autonomous product loop v1",
  "type": "object",
  "required": ["schemaVersion", "protocol", "id", "loopId", "revision", "state", "successMetric", "guardrails", "references", "history", "digest"],
  "properties": { "schemaVersion": { "const": 1 }, "protocol": { "const": "forgemind-autonomous-product-loop-v1" }, "id": { "type": "string" }, "loopId": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "state": { "enum": ["signal", "hypothesis", "experiment", "delivery", "scale", "iterate", "rollback"] }, "successMetric": { "type": "object" }, "guardrails": { "type": "array", "minItems": 1 }, "references": { "type": "object" }, "history": { "type": "array", "minItems": 1 }, "digest": { "$ref": "#/$defs/digest" } },
  "$defs": { "digest": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
  "additionalProperties": true
}
