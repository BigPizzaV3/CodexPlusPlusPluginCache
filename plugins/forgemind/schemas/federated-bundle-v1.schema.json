{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/federated-bundle-v1.schema.json",
  "title": "ForgeMind federated learning aggregate v1",
  "type": "object",
  "required": ["schemaVersion", "protocol", "id", "privacy", "cohorts", "digest"],
  "properties": { "schemaVersion": { "const": 1 }, "protocol": { "enum": ["forgemind-federated-learning-bundle-v1", "forgemind-federated-benchmark-v1"] }, "id": { "type": "string" }, "privacy": { "type": "object", "required": ["claim"] }, "cohorts": { "type": "array" }, "digest": { "$ref": "#/$defs/digest" } },
  "$defs": { "digest": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
  "additionalProperties": true
}
