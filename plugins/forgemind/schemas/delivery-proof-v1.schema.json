{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/delivery-proof-v1.schema.json",
  "title": "ForgeMind delivery proof v1",
  "type": "object",
  "required": ["schemaVersion", "deliveryId", "generatedAt", "status", "intent", "acceptanceCriteria", "git", "verification", "risks", "rollback", "unresolved", "blockers", "evidence", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["ready", "blocked"] }
  },
  "additionalProperties": true
}
