{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/executable-strategy-v1.schema.json",
  "title": "ForgeMind executable strategy v1",
  "type": "object",
  "required": ["schemaVersion", "protocol", "id", "constraints", "metrics", "driftChecks", "digest"],
  "properties": { "schemaVersion": { "const": 1 }, "protocol": { "const": "forgemind-executable-strategy-v1" }, "id": { "type": "string" }, "constraints": { "type": "array" }, "metrics": { "type": "array" }, "driftChecks": { "type": "array" }, "digest": { "$ref": "#/$defs/digest" } },
  "$defs": { "digest": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
  "additionalProperties": true
}
