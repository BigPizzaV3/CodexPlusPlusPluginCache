{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/RW-Forgemind-Codex-Plugin/schemas/config-v1.schema.json",
  "title": "ForgeMind configuration v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policy": { "type": "object" },
    "redaction": { "type": "object" },
    "routing": {
      "type": "object",
      "properties": { "maxSkillTokens": { "type": "integer", "minimum": 100 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
